# Application Environment Variables
# Copy this file to .env.local for local testing, or configure in Vercel Project Settings

# Production URL of your deployed application (used for QR code & NFC links)
APP_BASE_URL="https://your-domain.vercel.app"

# Groq Cloud API credentials for server-side AI review drafting
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Supabase database credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh...your_service_role_secret_key_here"
